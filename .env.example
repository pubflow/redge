# Redge environment example.
# Copy this file to .env for local development, but keep real secrets out of git.
#
# Important deployment note:
# - REDGE_HTTP_ADDR is for the HTTP status server used by platforms such as Coolify.
# - REDGE_ADDR is the real Redis/Valkey TCP listener used by Redis clients.
# - HTTPS on the status domain does not encrypt Redis TCP traffic.
# - For encrypted Redis clients, enable Redis TLS and connect with rediss://.

# -----------------------------------------------------------------------------
# Server ports and runtime
# -----------------------------------------------------------------------------

# Redis/Valkey TCP listener. In Coolify, expose this as a TCP public port only
# when clients must connect from outside the private network.
REDGE_ADDR=0.0.0.0:6379

# Public HTTP status server. Safe endpoints: GET /health, GET /ready, GET /version.
# In Coolify, point the HTTPS domain to this internal port, commonly 8080.
REDGE_HTTP_ENABLED=true
REDGE_HTTP_ADDR=0.0.0.0:8080

# Admin API is separate from the public status server. Keep disabled in production
# unless you set REDGE_ADMIN_TOKEN and restrict access.
REDGE_ADMIN_ENABLED=false
REDGE_ADMIN_ADDR=0.0.0.0:9090

# Valid values: development, test, production.
REDGE_ENV=development

# Logging.
REDGE_LOG_LEVEL=info
REDGE_LOG_FORMAT=json
REDGE_SHUTDOWN_TIMEOUT=10s

# -----------------------------------------------------------------------------
# Redis auth and network security
# -----------------------------------------------------------------------------

# Enable in production. Clients authenticate with AUTH <password> or
# redis://:PASSWORD@host:port/0. If the password contains special characters,
# URL-encode it or configure your client with separate host/port/password fields.
REDGE_REQUIRE_AUTH=false
REDGE_PASSWORD=

# Protected mode prevents accidental public unauthenticated Redis exposure.
# In production, a public REDGE_ADDR such as 0.0.0.0:6379 requires REDGE_PASSWORD.
REDGE_PROTECTED_MODE=true

# Optional Redis TCP allowlist. Comma-separated IPs or CIDR ranges.
# Leave empty to allow all source IPs. Examples:
# REDGE_ALLOWED_IPS=203.0.113.10,198.51.100.0/24,10.0.0.0/8
REDGE_ALLOWED_IPS=

# Maximum simultaneous Redis TCP connections. Use 0 for unlimited.
REDGE_MAX_CONNECTIONS=1000

# Delay applied after invalid AUTH attempts to slow brute-force retries.
REDGE_AUTH_FAILURE_DELAY=250ms

# Request and socket limits for Redis TCP.
REDGE_MAX_REQUEST_BYTES=1048576
REDGE_READ_TIMEOUT=30s
REDGE_WRITE_TIMEOUT=30s

# -----------------------------------------------------------------------------
# Redis TLS for rediss:// clients
# -----------------------------------------------------------------------------

# Enable native TLS on REDGE_ADDR. When enabled, plaintext redis:// clients will
# fail and clients must use rediss:// or TLS settings.
REDGE_TLS_ENABLED=false

# TLS material can come from env PEM, env base64, or mounted files.
# Precedence: PEM env > base64 env > file paths.
#
# Option 1: direct PEM env values. Some platforms support multiline secrets.
# You may also store PEM with literal \n sequences.
REDGE_TLS_CERT_PEM=
REDGE_TLS_KEY_PEM=

# Option 2: base64 env values. This is usually the easiest option in Coolify
# because it avoids multiline secret formatting issues.
# PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("fullchain.pem"))
# Linux/macOS: base64 -w0 fullchain.pem
REDGE_TLS_CERT_B64=
REDGE_TLS_KEY_B64=

# Option 3: mounted certificate files. For Coolify/Docker, mount your certificate
# directory to /certs when using this mode.
REDGE_TLS_CERT_FILE=/certs/fullchain.pem
REDGE_TLS_KEY_FILE=/certs/privkey.pem

# Valid values: 1.2 or 1.3. Go will prefer TLS 1.3 automatically when possible.
REDGE_TLS_MIN_VERSION=1.2

# Coolify's HTTPS/Traefik certificate protects only the HTTP status domain unless
# you also provide a certificate to Redge for Redis TLS. It is not automatically
# available inside this container and does not encrypt Redis TCP by itself.
#
# For public production, use a certificate from a trusted CA such as Let's Encrypt
# for the Redis hostname. If you use a private CA or self-signed certificate, each
# client must trust that CA, or use client-specific insecure mode only for tests.
#
# Example secure public client URLs:
# rediss://:PASSWORD@test1.conn.redgedb.com:6379/0
# redis-cli --tls -h test1.conn.redgedb.com -p 6379 -a "PASSWORD"
#
# Example strong public production preset:
# REDGE_ENV=production
# REDGE_REQUIRE_AUTH=true
# REDGE_PASSWORD=<strong-random-password>
# REDGE_PROTECTED_MODE=true
# REDGE_TLS_ENABLED=true
# REDGE_TLS_CERT_B64=<base64-fullchain-pem>
# REDGE_TLS_KEY_B64=<base64-private-key-pem>
# REDGE_ALLOWED_IPS=
#
# Recommended private production preset:
# - Do not publish REDGE_ADDR/6379 to the public internet.
# - Keep REDGE_REQUIRE_AUTH=true anyway.
# - Access Redis through a private network, VPN, tunnel, or internal service.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# SQLite is the simplest local/default option. In production containers, use a
# persistent volume, for example sqlite:///data/redge.db.
DATABASE_URL=sqlite://redge.db

# Optional Turso/libSQL and Cloudflare D1 settings, depending on DATABASE_URL.
# For D1, the recommended production form keeps the token separate:
# DATABASE_URL=d1://cloudflare_account_id/d1_database_id
# D1_API_TOKEN=<cloudflare-token>
#
# For quick deploys, Redge can also extract and sanitize D1 connection params:
# DATABASE_URL=d1://cloudflare_account_id/d1_database_id?apiToken=<cloudflare-token>
# DATABASE_URL=d1://cloudflare_account_id/d1_database_id?apiToken=<token>&baseUrl=https://api.cloudflare.com/client/v4
TURSO_AUTH_TOKEN=
D1_API_TOKEN=
D1_BASE_URL=
D1_RETRY_MAX=3
D1_RETRY_MIN_BACKOFF=200ms
D1_RETRY_MAX_BACKOFF=2s

# SQL connection pool and migrations.
DATABASE_MAX_OPEN_CONNS=50
DATABASE_MAX_IDLE_CONNS=10
DATABASE_CONN_MAX_LIFETIME=1h
REDGE_MIGRATIONS_AUTO=true

# -----------------------------------------------------------------------------
# Cache
# -----------------------------------------------------------------------------

REDGE_CACHE_ENABLED=true
REDGE_CACHE_MAX_KEYS=100000
REDGE_CACHE_MAX_BYTES=134217728
REDGE_CACHE_DEFAULT_TTL=5s

# -----------------------------------------------------------------------------
# Expiry cleanup
# -----------------------------------------------------------------------------

REDGE_EXPIRY_CLEANUP_ENABLED=true
REDGE_EXPIRY_CLEANUP_INTERVAL=30s
REDGE_EXPIRY_CLEANUP_LIMIT=1000

# -----------------------------------------------------------------------------
# Admin API
# -----------------------------------------------------------------------------

# Required when REDGE_ADMIN_ENABLED=true in production.
REDGE_ADMIN_TOKEN=

# Optional Admin API allowlist. Comma-separated IPs or CIDR ranges.
REDGE_ADMIN_ALLOWED_IPS=
REDGE_ADMIN_IP_CHECK_ENABLED=false

# Set true to prevent mutating admin operations.
REDGE_ADMIN_READONLY=false
