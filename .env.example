REDGE_ADMIN_ADDR=0.0.0.0:9090
REDGE_ENV=development
REDGE_PASSWORD=
REDGE_REQUIRE_AUTH=false

DATABASE_URL=sqlite://redge.db
TURSO_AUTH_TOKEN=
D1_API_TOKEN=
